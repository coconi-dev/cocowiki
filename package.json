{
  "name": "cocowiki-workspace",
  "version": "0.3.1",
  "author": "Mueo",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coconi-dev/cocowiki.git"
  },
  "scripts": {
    "dev": "node scripts/develop.mjs",
    "build": "pnpm --dir playground build",
    "preview": "pnpm --dir playground preview",
    "typecheck": "pnpm --dir packages/cocowiki typecheck",
    "check": "pnpm verify",
    "test:navigation": "node --test tests/page-navigation.test.mjs",
    "test:dev": "pnpm --dir packages/cocowiki build:package && node --test tests/dev-lifecycle.test.mjs",
    "test:content": "pnpm test",
    "bootstrap": "node scripts/framework.mjs",
    "dev:framework": "node scripts/develop.mjs --framework",
    "verify": "node scripts/verify.mjs",
    "sync:examples": "node scripts/sync-examples.mjs",
    "check:examples": "node scripts/sync-examples.mjs --check",
    "test": "pnpm bootstrap && node --test tests/*.test.mjs"
  }
}
